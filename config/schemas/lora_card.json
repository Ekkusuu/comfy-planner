    "trigger_words": {"type": "array", "items": {"type": "string"}, "maxItems": 12},
    "weight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rec", "min", "max"],
      "properties": {"rec": {"type": "number"}, "min": {"type": "number"}, "max": {"type": "number"}}
